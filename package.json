{
  "name": "potion-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && eslint . && vitest run && vite build",
    "smoke": "node scripts/smoke.cjs",
    "bot": "vitest run tests/playthrough.test.ts --reporter=default",
    "silhouettes": "node scripts/silhouettes.cjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}

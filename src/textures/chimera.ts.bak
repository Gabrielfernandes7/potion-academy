// Quimera de Mercúrio, chefe do Vale: as três partes do mito grego, em prata líquida. Corpo de leão, baixo e
// comprido, de quatro patas e de lado (cabeça de leão à frente, com juba curta); a cabeça de bode sai do meio
// das costas, num pescoço alto, com chifres; a cauda é uma serpente que sobe atrás e termina numa cabecinha com
// língua. O corpo é uma poça que se ergue; pinga e brilha em azul pálido. Mesmo tamanho da Roo (tile + folga no topo).
//
// Silhueta: comprida e horizontal, com DUAS pontas que sobem (o bode e a serpente). O Leão Verde, ao contrário,
// é um leão sentado, compacto e vertical, de juba grande: os dois se distinguem em preto e branco.
//
// Poses: 'idle' (2 quadros: a cauda, o pescoço do bode e a poça ondulam), 'cast' (boca aberta, brilho azul, cabeça erguida),
//        'hurt' (olhos em X), 'talk' (2 quadros: boca abre e fecha),
//        'defeat' (vencida: já quase só poça, olhos fechados, cabeças baixas).
import Phaser from 'phaser';
import { ROO_HEAD_ROOM, rooTextureHeight } from './rooGeometry';

type Gfx = Phaser.GameObjects.Graphics;
type Pt = readonly [number, number];
type ChimeraPose = 'idle' | 'cast' | 'hurt' | 'talk' | 'defeat';

const SILVER = 0xb0bec5;
const SILVER_LIGHT = 0xeceff1;
const SILVER_SHADE = 0x78909c;
const SILVER_DARK = 0x37474f;
const BLUE = 0x90caf9;
const BLUE_DEEP = 0x1e88e5;
const HORN = 0xcfd8dc;
const HOLE = 0x1c2a33;

function poly(g: Gfx, pts: Pt[], color: number, alpha = 1): void {
  g.fillStyle(color, alpha);
  g.beginPath();
  g.moveTo(pts[0][0], pts[0][1]);
  for (let i = 1; i < pts.length; i++) g.lineTo(pts[i][0], pts[i][1]);
  g.closePath();
  g.fillPath();
}

function seg(g: Gfx, a: Pt, b: Pt, color: number, width: number, alpha = 1): void {
  g.lineStyle(width, color, alpha);
  g.beginPath(); g.moveTo(a[0], a[1]); g.lineTo(b[0], b[1]); g.strokePath();
}

function drawChimeraFrame(g: Gfx, T: number, frame: number, pose: ChimeraPose): void {
  g.clear();
  const f = frame % 2;
  const defeat = pose === 'defeat';
  const casting = pose === 'cast';
  const hurt = pose === 'hurt';
  const talkOpen = pose === 'talk' && f === 1;
  const B = rooTextureHeight(T);
  const cx = T / 2;
  const wob = defeat ? 0 : f === 0 ? -0.8 : 0.8;
  const sink = defeat ? 5 : hurt ? 0.8 : 0; // vencida, o corpo desce para a poça

  // sombra
  g.fillStyle(0x000000, 0.22);
  g.fillEllipse(cx, B - 2, 32, 4);

  // poça de mercúrio na base, com pingos
  g.fillStyle(SILVER_SHADE);
  g.fillEllipse(cx, B - 5, defeat ? 34 : 30, defeat ? 8 : 7);
  g.fillStyle(SILVER);
  g.fillEllipse(cx - 1, B - 6, defeat ? 30 : 26, defeat ? 6 : 5);
  g.fillStyle(SILVER_LIGHT, 0.8);
  g.fillEllipse(cx - 6, B - 7, 8, 1.6);
  if (!defeat) {
    g.fillStyle(SILVER);
    g.fillTriangle(cx + 13, B - 7, cx + 16, B - 7, cx + 14.5 + wob * 0.3, B - 3);
    g.fillTriangle(cx - 16, B - 7, cx - 13, B - 7, cx - 14.5 - wob * 0.3, B - 3.5);
  }

  // cauda de serpente: sai de trás do corpo, sobe curvando e termina numa cabecinha com língua virada para o bode
  if (!defeat) {
    const tail: Pt[] = [
      [cx + 14, B - 13], [cx + 18 + wob * 0.6, B - 17], [cx + 18 + wob, B - 24], [cx + 14 + wob * 1.6, B - 30],
    ];
    for (let i = 0; i < tail.length - 1; i++) seg(g, tail[i], tail[i + 1], SILVER_SHADE, 3.6 - i * 0.7);
    for (let i = 0; i < tail.length - 1; i++) seg(g, tail[i], tail[i + 1], SILVER, 2.2 - i * 0.4);
    const [hx, hy] = tail[3];
    g.fillStyle(SILVER); g.fillEllipse(hx, hy - 1, 5, 4);
    g.fillStyle(BLUE_DEEP); g.fillCircle(hx - 0.8, hy - 1.6, 0.8);
    seg(g, [hx - 2, hy - 0.4], [hx - 4.4, hy + 0.4 + wob * 0.2], 0xff5252, 0.8);
  }

  // corpo de leão, baixo e comprido: patas de trás e da frente, tronco e peito
  const by = B - 13 + sink; // altura do meio do tronco
  g.fillStyle(SILVER_SHADE);
  g.fillEllipse(cx + 10, B - 8.5, 6, 6);
  g.fillEllipse(cx + 15, B - 8, 5, 5);
  poly(g, [[cx - 10, B - 8], [cx - 11, by - 1], [cx - 4, by - 7], [cx + 12, by - 6], [cx + 17, by + 1], [cx + 16, B - 8]], SILVER_SHADE);
  g.fillStyle(SILVER);
  g.fillEllipse(cx + 3, by + 1, 28, 14);
  g.fillStyle(SILVER_LIGHT, 0.7);
  g.fillEllipse(cx - 2, by - 2, 12, 3.4);
  g.fillStyle(BLUE, 0.35);
  g.fillEllipse(cx + 8, by + 3, 8, 6);
  // patas da frente (mais perto de quem olha) com garras
  g.fillStyle(SILVER);
  g.fillEllipse(cx - 9, B - 8, 6, 6.4);
  g.fillEllipse(cx - 3, B - 7.6, 5.6, 6);
  g.fillStyle(SILVER_DARK, 0.7);
  for (const dx of [-10.6, -8.6, -4.4, -2.4]) g.fillRect(cx + dx, B - 5.4, 0.9, 1.4);

  // cabeça de bode: sobe de um pescoço no meio das costas, com chifres que curvam para trás
  const gx = cx + 3 + (defeat ? 3 : wob * 0.5);
  const gy = B - 31 + (defeat ? 8 : 0);
  poly(g, [[cx - 3, by - 5], [cx + 5, by - 5], [gx + 3.4, gy + 6], [gx - 3.4, gy + 6]], SILVER_SHADE); // pescoço grosso
  poly(g, [[cx - 1, by - 5], [cx + 3, by - 5], [gx + 2, gy + 6], [gx - 2, gy + 6]], SILVER);
  g.fillStyle(SILVER_SHADE); g.fillEllipse(gx, gy, 10, 10.4);
  g.fillStyle(SILVER); g.fillEllipse(gx - 0.4, gy - 0.4, 8.4, 9);
  // chifres de bode: dois arcos que sobem e curvam para trás (para a direita)
  for (const s of [-1, 1]) {
    const base: Pt = [gx + s * 2.2, gy - 4];
    const mid: Pt = [gx + s * 3.2 + 1.5, gy - 9];
    const tip: Pt = [gx + s * 3.2 + 6.4, gy - 9.6 + (defeat ? 2 : 0)];
    seg(g, base, mid, HORN, 2.2);
    seg(g, mid, tip, HORN, 1.5);
    seg(g, base, mid, SILVER_SHADE, 0.8, 0.6);
  }
  g.fillStyle(SILVER_LIGHT, 0.85); g.fillEllipse(gx - 0.4, gy + 3.4, 4.6, 3); // focinho
  seg(g, [gx - 0.4, gy + 4.6], [gx - 0.6, gy + 7.4], SILVER_LIGHT, 1);          // barbicha
  if (hurt) {
    seg(g, [gx - 2.6, gy - 1.6], [gx - 0.4, gy + 0.4], HOLE, 1);
    seg(g, [gx - 0.4, gy - 1.6], [gx - 2.6, gy + 0.4], HOLE, 1);
  } else if (defeat) {
    seg(g, [gx - 2.8, gy - 0.4], [gx - 0.6, gy - 0.4], HOLE, 1);
  } else {
    g.fillStyle(BLUE_DEEP); g.fillCircle(gx - 1.6, gy - 0.8, 1.1);
    g.fillStyle(0xffffff); g.fillCircle(gx - 1.9, gy - 1.1, 0.4);
  }

  // cabeça de leão, à frente (esquerda), com juba curta de pontas de prata
  const hcx = cx - 10 + (defeat ? 1 : 0);
  const hcy = B - 25 + (casting ? -1 : 0) + (defeat ? 8 : hurt ? 0.8 : 0);
  g.fillStyle(SILVER_SHADE);
  const mane = 9;
  for (let i = 0; i < mane; i++) {
    const a = (i / mane) * Math.PI * 2;
    const r1 = 6;
    const r2 = 10 + (i % 2 === 0 ? 1.1 : 0) + (i % 3 === 0 ? wob * 0.4 : 0);
    const px = Math.cos(a);
    const py = Math.sin(a);
    g.fillTriangle(
      hcx + px * r1 - py * 2.4, hcy + py * r1 + px * 2.4,
      hcx + px * r1 + py * 2.4, hcy + py * r1 - px * 2.4,
      hcx + px * r2, hcy + py * r2,
    );
  }
  g.fillStyle(SILVER);
  g.fillCircle(hcx, hcy, 7.4);
  g.fillStyle(SILVER_LIGHT, 0.75);
  g.fillEllipse(hcx - 3, hcy - 3.6, 4.4, 2.6);

  // rosto de leão
  if (hurt) {
    for (const ex of [hcx - 2.9, hcx + 2.9]) {
      seg(g, [ex - 1.4, hcy - 3.2], [ex + 1.4, hcy - 0.8], HOLE, 1.1);
      seg(g, [ex + 1.4, hcy - 3.2], [ex - 1.4, hcy - 0.8], HOLE, 1.1);
    }
  } else if (defeat) {
    g.lineStyle(1.1, HOLE);
    for (const ex of [hcx - 2.9, hcx + 2.9]) {
      g.beginPath(); g.arc(ex, hcy - 2.2, 1.6, 0.2, Math.PI - 0.2, false); g.strokePath();
    }
  } else {
    g.fillStyle(HOLE);
    g.fillEllipse(hcx - 2.9, hcy - 2.4, 3.8, casting ? 3.6 : 2.8);
    g.fillEllipse(hcx + 2.9, hcy - 2.4, 3.8, casting ? 3.6 : 2.8);
    g.fillStyle(casting ? 0xffffff : BLUE);
    g.fillEllipse(hcx - 2.9, hcy - 2.4, 2.3, casting ? 2.5 : 1.6);
    g.fillEllipse(hcx + 2.9, hcy - 2.4, 2.3, casting ? 2.5 : 1.6);
    seg(g, [hcx - 5.4, hcy - 4.8], [hcx - 1.6, hcy - 3.6], SILVER_DARK, 1.1);
    seg(g, [hcx + 5.4, hcy - 4.8], [hcx + 1.6, hcy - 3.6], SILVER_DARK, 1.1);
  }
  // focinho e nariz de leão
  g.fillStyle(SILVER_SHADE);
  g.fillEllipse(hcx, hcy + 2.4, 7, 4.4);
  poly(g, [[hcx - 1.6, hcy], [hcx + 1.6, hcy], [hcx, hcy + 1.8]], SILVER_DARK);
  // boca
  if (casting) {
    g.fillStyle(BLUE, 0.35); g.fillCircle(hcx, hcy + 5, 6.4);
    g.fillStyle(BLUE, 0.5); g.fillCircle(hcx, hcy + 5, 3.8);
    g.fillStyle(HOLE); g.fillEllipse(hcx, hcy + 4.6, 4, 3.4);
    g.fillStyle(0xffffff); g.fillTriangle(hcx - 1.6, hcy + 3.2, hcx - 0.5, hcy + 3.2, hcx - 1.1, hcy + 4.6);
    g.fillTriangle(hcx + 0.5, hcy + 3.2, hcx + 1.6, hcy + 3.2, hcx + 1.1, hcy + 4.6);
  } else if (talkOpen) {
    g.fillStyle(HOLE); g.fillEllipse(hcx, hcy + 4.6, 3.4, 2.4);
  } else if (hurt) {
    seg(g, [hcx - 2.2, hcy + 5.2], [hcx, hcy + 4], SILVER_DARK, 1);
    seg(g, [hcx, hcy + 4], [hcx + 2.2, hcy + 5.2], SILVER_DARK, 1);
  } else if (defeat) {
    seg(g, [hcx - 1.8, hcy + 4.6], [hcx + 1.8, hcy + 4.6], SILVER_DARK, 1);
  } else {
    seg(g, [hcx - 2.4, hcy + 4.4], [hcx, hcy + 5.2], SILVER_DARK, 1);
    seg(g, [hcx, hcy + 5.2], [hcx + 2.4, hcy + 4.4], SILVER_DARK, 1);
  }
  // gotas de mercúrio escorrendo do queixo
  if (!defeat && !casting) {
    g.fillStyle(SILVER_LIGHT);
    g.fillCircle(hcx - 3.6 + wob * 0.2, hcy + 9 + (f === 0 ? 0 : 1), 0.9);
  }
}

export function drawChimeraTextures(g: Gfx, T: number): void {
  const H = rooTextureHeight(T);
  for (let fi = 0; fi < 2; fi++) {
    drawChimeraFrame(g, T, fi, 'idle');
    g.generateTexture(`chimera_idle_${fi}`, T, H);
  }
  drawChimeraFrame(g, T, 0, 'cast');
  g.generateTexture('chimera_cast', T, H);
  drawChimeraFrame(g, T, 0, 'hurt');
  g.generateTexture('chimera_hurt', T, H);
  for (let fi = 0; fi < 2; fi++) {
    drawChimeraFrame(g, T, fi, 'talk');
    g.generateTexture(`chimera_talk_${fi}`, T, H);
  }
  drawChimeraFrame(g, T, 0, 'defeat');
  g.generateTexture('chimera_defeat', T, H);
}
